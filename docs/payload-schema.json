{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/brian-a-au/sdr-visualizer/main/docs/payload-schema.json",
  "title": "sdr-visualizer data payload",
  "description": "The JSON embedded in every report (script#sdr-data) and emitted by --json. Covered by the 1.0.0 stability contract: removing or retyping a field is a major version bump; adding optional fields is minor. segment_trees/formula_trees node internals are render structures and are deliberately loosely specified (only 'kind' is pinned).",
  "type": "object",
  "required": ["meta", "components", "segments", "calculated_metrics", "graph", "segment_trees", "formula_trees"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["instance_id", "instance_name", "platform", "snapshot_taken_at", "snapshot_source", "adapter_version", "visualizer_version", "generated_at", "component_count", "exclude_orphans_default"],
      "additionalProperties": false,
      "properties": {
        "instance_id": {"type": "string"},
        "instance_name": {"type": "string"},
        "platform": {"enum": ["cja", "aa"]},
        "snapshot_taken_at": {"type": ["string", "null"]},
        "snapshot_source": {"type": "string"},
        "adapter_version": {"type": "string"},
        "visualizer_version": {"type": "string"},
        "generated_at": {"type": "string"},
        "component_count": {"type": "integer", "minimum": 0},
        "exclude_orphans_default": {"type": "boolean"},
        "max_graph_nodes": {"type": "integer", "minimum": 0},
        "compared_to": {"$ref": "#/$defs/baselineRef"}
      }
    },
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "calculated_metrics": {"type": "array", "items": {"$ref": "#/$defs/calculatedMetric"}},
    "graph": {
      "type": "object",
      "required": ["edges"],
      "additionalProperties": false,
      "properties": {
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolvedReference"}}
      }
    },
    "segment_trees": {"type": "object", "additionalProperties": {"$ref": "#/$defs/treeNode"}},
    "formula_trees": {"type": "object", "additionalProperties": {"$ref": "#/$defs/treeNode"}},
    "changes": {"$ref": "#/$defs/changes"},
    "trend": {"$ref": "#/$defs/trend"},
    "workspace_usage": {"$ref": "#/$defs/workspaceUsage"}
  },
  "$defs": {
    "workspaceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence",
        "binding",
        "generated_at",
        "summary",
        "display"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "evidence": {
          "$ref": "#/$defs/workspaceEvidence"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization_context",
            "snapshot"
          ],
          "properties": {
            "organization_context": {
              "const": "operator_asserted"
            },
            "snapshot": {
              "const": "matched"
            },
            "company_context": {
              "const": "operator_asserted"
            }
          }
        },
        "generated_at": {
          "type": "string"
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "partial",
            "failed",
            "attempted",
            "requested"
          ],
          "properties": {
            "complete": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "attempted": {
              "type": "integer",
              "minimum": 0
            },
            "requested": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "display": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "state",
              "reason",
              "time_quality",
              "checked_at_utc",
              "age_at_generation",
              "limitations"
            ],
            "properties": {
              "component": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "metric",
                      "dimension",
                      "derived_field",
                      "segment",
                      "calculated_metric"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false
              },
              "state": {
                "enum": [
                  "not_checked",
                  "failed",
                  "partial",
                  "references_found",
                  "no_references_found"
                ]
              },
              "reason": {
                "enum": [
                  "component_not_included",
                  "collection_failed",
                  "no_result_collected",
                  "attempted_result"
                ]
              },
              "time_quality": {
                "enum": [
                  "missing",
                  "invalid",
                  "future",
                  "valid"
                ]
              },
              "checked_at_utc": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "age_at_generation": {
                "enum": [
                  null,
                  "older_than_24h",
                  "within_24h"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "result_index": {
                "type": "integer",
                "minimum": 0
              },
              "project_count": {
                "type": "integer",
                "minimum": 0
              },
              "match_basis": {
                "enum": [
                  "exact_component_id",
                  "unverified_lookup"
                ]
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "failed"
                ]
              },
              "checked_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure": {
                "enum": [
                  "permission_denied",
                  "collection_error",
                  "unsupported",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "workspaceEvidence": {
      "title": "Workspace project usage v1",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "platform": {
                  "enum": [
                    "cja"
                  ]
                },
                "ims_org_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "data_view_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "snapshot_digest": {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "enum": [
                        "sdr-python-json-sha256-v1"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "platform",
                "ims_org_id",
                "data_view_id",
                "snapshot_digest"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "platform": {
                  "enum": [
                    "aa"
                  ]
                },
                "ims_org_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "global_company_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "rsid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "snapshot_digest": {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "enum": [
                        "sdr-python-json-sha256-v1"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "platform",
                "ims_org_id",
                "global_company_id",
                "rsid",
                "snapshot_digest"
              ],
              "additionalProperties": false
            }
          ]
        },
        "collection": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "failed"
              ]
            },
            "project_scope": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "accessible_projects"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "explicit_projects"
                      ]
                    },
                    "project_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                      },
                      "maxItems": 10000,
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "kind",
                    "project_ids"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "permission_visibility": {
              "enum": [
                "limited",
                "unknown"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 20,
              "minItems": 0,
              "uniqueItems": false
            },
            "failure": {
              "enum": [
                "permission_denied",
                "collection_error",
                "unsupported",
                "unknown"
              ]
            },
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "sdk_candidates"
                  ]
                },
                "sdk": {
                  "enum": [
                    "cjapy",
                    "aanalytics2"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "kind",
                "sdk",
                "version"
              ],
              "additionalProperties": false
            },
            "retrieval": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "complete",
                    "partial",
                    "failed"
                  ]
                },
                "started_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 64
                },
                "finished_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 64
                },
                "include_type": {
                  "enum": [
                    "all",
                    "owned",
                    "shared",
                    "explicit"
                  ]
                },
                "request_attempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 256
                },
                "pages_fetched": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "projects_discovered": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "projects_fetched": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "projects_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 20,
                  "minItems": 0,
                  "uniqueItems": false
                }
              },
              "required": [
                "status",
                "started_at",
                "finished_at",
                "include_type",
                "request_attempts",
                "pages_fetched",
                "projects_discovered",
                "projects_fetched",
                "projects_failed",
                "limitations"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "project_scope",
            "permission_visibility",
            "limitations"
          ],
          "additionalProperties": false
        },
        "requested_components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "metric",
                  "dimension",
                  "derived_field",
                  "segment",
                  "calculated_metric"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 2000,
          "minItems": 1,
          "uniqueItems": true
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "metric",
                      "dimension",
                      "derived_field",
                      "segment",
                      "calculated_metric"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "failed"
                ]
              },
              "checked_at": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 0,
                "maxLength": 64
              },
              "match_basis": {
                "enum": [
                  "exact_component_id",
                  "unverified_lookup"
                ]
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000,
                "minItems": 0,
                "uniqueItems": false
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "maxItems": 20,
                "minItems": 0,
                "uniqueItems": false
              },
              "failure": {
                "enum": [
                  "permission_denied",
                  "collection_error",
                  "unsupported",
                  "unknown"
                ]
              }
            },
            "required": [
              "component",
              "status",
              "checked_at",
              "match_basis",
              "projects",
              "limitations"
            ],
            "additionalProperties": false
          },
          "maxItems": 2000,
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "schema_version",
        "target",
        "collection",
        "requested_components",
        "results"
      ],
      "additionalProperties": false
    },
    "unresolvedReference": {
      "type": "object",
      "required": ["source", "reference", "reason"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "reference": {"type": "string"},
        "reference_type": {"enum": ["dimension", "metric", "segment"]},
        "reason": {"enum": ["ambiguous", "missing"]}
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "type", "name", "in_degree", "out_degree"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["metric", "dimension", "derived_field"]},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "data_type": {"type": "string"},
        "polarity": {"enum": ["positive", "negative", "neutral"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": "string"},
        "created_at": {"type": "string"},
        "modified_at": {"type": "string"},
        "modified_ts": {"type": "integer"},
        "derived_kind": {"enum": ["dimension", "metric"]},
        "in_degree": {"type": "integer", "minimum": 0},
        "out_degree": {"type": "integer", "minimum": 0}
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "type", "name", "nesting_depth", "in_degree", "out_degree"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "segment"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "nesting_depth": {"type": "integer", "minimum": 0},
        "container_types": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": "string"},
        "created_at": {"type": "string"},
        "modified_at": {"type": "string"},
        "modified_ts": {"type": "integer"},
        "in_degree": {"type": "integer", "minimum": 0},
        "out_degree": {"type": "integer", "minimum": 0}
      }
    },
    "calculatedMetric": {
      "type": "object",
      "required": ["id", "type", "name", "complexity_score", "in_degree", "out_degree"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"const": "calculated_metric"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "formula_text": {"type": "string"},
        "complexity_score": {"type": "number"},
        "attribution_model": {"type": "string"},
        "allocation": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}},
        "owner": {"type": "string"},
        "created_at": {"type": "string"},
        "modified_at": {"type": "string"},
        "modified_ts": {"type": "integer"},
        "in_degree": {"type": "integer", "minimum": 0},
        "out_degree": {"type": "integer", "minimum": 0}
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "kind"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "target": {"type": "string"},
        "kind": {"const": "references"}
      }
    },
    "treeNode": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"type": "string"}}
    },
    "baselineRef": {
      "type": "object",
      "required": ["source", "taken_at", "instance_id"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "taken_at": {"type": ["string", "null"]},
        "instance_id": {"type": "string"}
      }
    },
    "changeEntry": {
      "type": "object",
      "required": ["id", "type", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["metric", "dimension", "derived_field", "segment", "calculated_metric"]},
        "name": {"type": "string"}
      }
    },
    "fieldChange": {
      "oneOf": [
        {
          "type": "object",
          "required": ["field", "old", "new"],
          "additionalProperties": false,
          "properties": {
            "field": {"type": "string"},
            "old": {"type": ["string", "number", "boolean", "null"]},
            "new": {"type": ["string", "number", "boolean", "null"]}
          }
        },
        {
          "type": "object",
          "required": ["field", "added", "removed"],
          "additionalProperties": false,
          "properties": {
            "field": {"type": "string"},
            "added": {"type": "array", "items": {"type": "string"}},
            "removed": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "modifiedEntry": {
      "type": "object",
      "required": ["id", "type", "name", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["metric", "dimension", "derived_field", "segment", "calculated_metric"]},
        "name": {"type": "string"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/fieldChange"}}
      }
    },
    "changes": {
      "type": "object",
      "required": ["baseline", "added", "removed", "modified"],
      "additionalProperties": false,
      "properties": {
        "baseline": {"$ref": "#/$defs/baselineRef"},
        "added": {"type": "array", "items": {"$ref": "#/$defs/changeEntry"}},
        "removed": {"type": "array", "items": {"$ref": "#/$defs/changeEntry"}},
        "modified": {"type": "array", "items": {"$ref": "#/$defs/modifiedEntry"}}
      }
    },
    "aggregates": {
      "type": "object",
      "required": ["total", "metrics", "dimensions", "derived_fields", "segments", "calculated_metrics", "orphans", "no_description", "edges"],
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "metrics": {"type": "integer", "minimum": 0},
        "dimensions": {"type": "integer", "minimum": 0},
        "derived_fields": {"type": "integer", "minimum": 0},
        "segments": {"type": "integer", "minimum": 0},
        "calculated_metrics": {"type": "integer", "minimum": 0},
        "orphans": {"type": "integer", "minimum": 0},
        "no_description": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0}
      }
    },
    "trendSnapshot": {
      "type": "object",
      "required": ["source", "taken_at", "aggregates"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "taken_at": {"type": ["string", "null"]},
        "aggregates": {"$ref": "#/$defs/aggregates"}
      }
    },
    "trendInterval": {
      "type": "object",
      "required": ["from", "to", "from_source", "to_source", "added", "removed", "modified"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "from_source": {"type": "string"},
        "to_source": {"type": "string"},
        "added": {"type": "array", "items": {"type": "string"}},
        "removed": {"type": "array", "items": {"type": "string"}},
        "modified": {"type": "array", "items": {"type": "string"}}
      }
    },
    "trend": {
      "type": "object",
